{
  "format_version": "1.26.0",
  "minecraft:entity": {
    
    "description": {
      "identifier": "x:move",
      "is_summonable": true
    },

    "components": {
      "minecraft:physics": { "has_collision": false, "has_gravity": false },
      "minecraft:collision_box": { "height": 0.0001, "width": 0.0001 },
      "minecraft:custom_hit_test": { "hitboxes": [ { "width": 0.00001, "height": 0.00001, "pivot": [ 0, 10000, 0 ] } ] },
      "minecraft:knockback_resistance": { "value": 1, "max": 1 },
      "minecraft:health": { "value": 1, "min": 1 },
      "minecraft:breathable": { "breathes_water": true, "breathes_lava": true, "breathes_solids": true },
      "minecraft:type_family": {"family": ["x:move","x"]},
      "minecraft:nameable": { "allow_name_tag_renaming": false, "always_show": true },
      "minecraft:equippable": { "slots": [ { "slot": 0 } ] },
      "minecraft:tick_world": { "never_despawn": true, "radius": 2 },
      "minecraft:timer": { "time": 600, "looping": true, "time_down_event": { "event": "x:despawn" } }
    },

    "component_groups": {
      "x:despawn":{"minecraft:instant_despawn":{}}
    },

    "events": {
      "x:despawn":{"add": { "component_groups": [ "x:despawn" ] }}
    }
  }
}
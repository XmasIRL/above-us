{
    
  "format_version": "1.26.0",

  "minecraft:entity": {
  
    "description": {
      "identifier": "x:platform",
      "is_spawnable": false,
      "is_summonable": true
    },

    "component_groups": {
      "x:despawn": { "minecraft:instant_despawn": {} }
    },

    "components": {
      "minecraft:physics": { "has_collision": true, "has_gravity": false },
      "minecraft:breathable": { "breathes_air": true, "breathes_water": true, "breathes_lava": true, "breathes_solids": true },
      "minecraft:health": { "value": 1, "min": 1 },
      "minecraft:collision_box": { "height": 1, "width": 1 },
      "minecraft:is_collidable": {},
      "minecraft:custom_hit_test": { "hitboxes": [ { "width": 0.00001, "height": 0.00001, "pivot": [ 0, 100, 0 ] } ] },
      "minecraft:knockback_resistance": { "value": 1, "max": 1 },
      "minecraft:environment_sensor": { "triggers": [ { "event": "x:despawn", "target": "self", "filters": { "test": "distance_to_nearest_player", "operator":">", "value": 10 } } ] }
      // "minecraft:timer": { "time": 2, "looping": true, "time_down_event": { "event": "x:despawn", "target": "self" } }
    },

    "events": {
      "x:despawn": { "add": { "component_groups": [ "x:despawn" ] } }
    }
  }
}

{
    
  "format_version": "1.26.0",

  "minecraft:entity": {
  
    "description": {
      "identifier": "x:ride",
      "is_spawnable": false,
      "is_summonable": true
    },

    "component_groups": {
      "x:despawn": { "minecraft:instant_despawn": {} }
    },

    "components": {
      "minecraft:rideable": { "family_types": ["mob"], "interact_text": "", "seat_count": 1 },
      "minecraft:physics": { "has_collision": true, "has_gravity": false },
      "minecraft:breathable": { "breathes_air": true, "breathes_water": true, "breathes_lava": true, "breathes_solids": true },
      "minecraft:health": { "value": 1, "min": 1 },
      "minecraft:collision_box": { "height": 0.00001, "width": 0.00001 },
      "minecraft:custom_hit_test": { "hitboxes": [ { "width": 0.00001, "height": 0.00001, "pivot": [ 0, 100, 0 ] } ] },
      "minecraft:knockback_resistance": { "value": 1, "max": 1 },
      "minecraft:environment_sensor": { "triggers": [ { "event": "x:despawn", "target": "self", "filters": { "test": "rider_count", "operator":"<", "value": 1 } } ] }
    },

    "events": {
      "x:despawn": { "add": { "component_groups": [ "x:despawn" ] } }
    }
  }
}

{
  "format_version": "1.10.0",
  "animations": {
		
		"animation.default" : {
			"bones" : { "root" : {} }
		},

    "animation.hide": {
      "loop": "hold_on_last_frame",
			"override_previous_animation": true,
      "animation_length": 0.5,
      "bones": {
				"head" : { "scale" : 0 },
				"root" : { "scale" : 0 }
      }
    }
  }
}
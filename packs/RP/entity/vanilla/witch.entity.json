{
  "format_version": "1.16.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "x:witch",
      "min_engine_version": "1.8.0",
      "materials" : { "default": "witch" },
      "textures"  : { "default": "textures/entity/witch" },
      "geometry"  : { "default": "geometry.villager.witch.v1.8" },
      "scripts"   : { 
        "scale": "0.9375", 
        "pre_animation": [
          "variable.isholdingitem = query.is_item_equipped(0);"
        ],
        "animate": [
          "general_controller",
          "move_controller"
        ]
      },
      "animations": {
        "villager_general"      : "animation.villager.general",
        "look_at_target"        : "animation.common.look_at_target",
        "move"                  : "animation.villager.move",
        "general"               : "animation.witch.general",
        "general_controller"    : "controller.animation.witch.general",
        "move_controller"       : "controller.animation.villager.move"
      },
      "render_controllers": [ "controller.render.witch" ],
      "spawn_egg": { "texture": "spawn_egg_witch" }
    }
  }
}